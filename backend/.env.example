# Copia este archivo como .env y completa los valores.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=reportes_vecinales
DB_PORT=3306
PORT=3000

# Clave para firmar las sesiones: larga y aleatoria. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcional: restringe qué sitio puede usar la API (por ejemplo https://miweb.com).
# CORS_ORIGIN=
# Opcional: si el servidor está detrás de un proxy o balanceador, poner 1.
# TRUST_PROXY=1

# ── Ingreso y correo (ver docs/CONFIGURAR_INGRESO.md) ──
# Correo desde el que se envían los códigos de confirmación (con Gmail: contraseña de aplicación).
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=Voz Vecinal
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# Ingreso con Google (ID de cliente de OAuth).
# GOOGLE_CLIENT_ID=
# Verificación anti-bots en el registro (Cloudflare Turnstile, gratis).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# Ingreso con Facebook.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ── Seguridad de la página (solo cuando el servidor entrega el frontend compilado) ──
# Si algo deja de funcionar por la política de contenido, pon 1 para que solo avise en la consola del navegador.
# CSP_SOLO_REPORTE=1
