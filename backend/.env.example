# Copia este archivo como .env y completa los valores.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=reportes_vecinales
DB_PORT=3306
PORT=3000

# Clave para firmar las sesiones: larga y aleatoria. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcional: restringe qué sitio puede usar la API (por ejemplo https://miweb.com).
# CORS_ORIGIN=
# Opcional: si el servidor está detrás de un proxy o balanceador, poner 1.
# TRUST_PROXY=1

# ── Ingreso y correo (ver docs/CONFIGURAR_INGRESO.md) ──
# Correo desde el que se envían los códigos de confirmación (con Gmail: contraseña de aplicación).
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=Voz Vecinal
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# Ingreso con Google (ID de cliente de OAuth).
# GOOGLE_CLIENT_ID=
# Ingreso con Facebook.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
