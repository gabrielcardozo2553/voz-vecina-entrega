# Copia este archivo como .env y completa los valores.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=reportes_vecinales
DB_PORT=3306
PORT=3000

# Clave para firmar las sesiones: larga y aleatoria. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcional: restringe qué sitio puede usar la API (por ejemplo https://miweb.com).
# CORS_ORIGIN=
# Opcional: si el servidor está detrás de un proxy o balanceador, poner 1.
# TRUST_PROXY=1

# ── Ingreso y correo (ver docs/CONFIGURAR_INGRESO.md) ──
# Correo desde el que se envían los códigos de confirmación (con Gmail: contraseña de aplicación).
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=Voz Vecinal
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# Ingreso con Google (ID de cliente de OAuth).
# GOOGLE_CLIENT_ID=
# Verificación anti-bots en el registro (Cloudflare Turnstile, gratis).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# Ingreso con Facebook.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ── Seguridad de la página (solo cuando el servidor entrega el frontend compilado) ──
# Si algo deja de funcionar por la política de contenido, pon 1 para que solo avise en la consola del navegador.
# CSP_SOLO_REPORTE=1

# ── Despliegue en la nube (ver docs/DESPLIEGUE_GRATIS.md) ──
# Base de datos que exige conexión cifrada (Aiven y similares): DB_SSL=1 y el certificado en DB_SSL_CA.
# DB_SSL=1
# DB_SSL_CA=
# Fotos en Cloudinary (en un hosting gratuito el disco se borra, así que las fotos van a la nube).
# CLOUDINARY_URL=cloudinary://CLAVE:SECRETO@NOMBRE_DE_LA_NUBE
# Correo por HTTPS con Brevo (los hostings gratuitos bloquean SMTP).
# BREVO_API_KEY=
# MAIL_REMITENTE=
# Esta cuenta (con el correo ya confirmado) pasa a ser administradora.
# ADMIN_EMAIL=

# Cifrado del DNI en la base de datos (recomendado). Usa una frase larga y aleatoria, de al menos 16 caracteres.
# GUÁRDALA en un lugar seguro: si se pierde, los DNI cifrados no se pueden recuperar. No la cambies una vez en uso.
# DNI_KEY=

# Notificaciones push al celular (opcional). Genera las claves con:  npm run claves-push
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
